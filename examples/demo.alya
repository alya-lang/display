## Example usage and walkthrough for display
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== display Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. Live enumeration (headless-safe)
    # ───────────────────────────────────────────────────────────
    say "--- 1. Live Enumeration ---"
    let n = pkg::display_count()
    say "Count:    " + str(n)
    say "Headless: " + str(pkg::headless())
    say "Summary:  " + pkg::summary()
    say ""
    let list = pkg::displays()
    if len(list) == 0
        say "(no displays reachable — CI/Docker/SSH headless path)"
    else
        for d in list
            say "  - " + pkg::format_display(d)
        end
    end
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. Primary / largest / virtual desktop
    # ───────────────────────────────────────────────────────────
    say "--- 2. Primary & Layout ---"
    let prim = pkg::primary_or_first()
    if prim is null
        say "Primary:  (none)"
    else
        say "Primary:  " + pkg::format_display(prim)
    end
    say "Layout:   " + pkg::layout().summary()
    say "Total px: " + str(pkg::total_px())
    say "Details:"
    say pkg::details()
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. Synthetic records (works everywhere, no display needed)
    # ───────────────────────────────────────────────────────────
    say "--- 3. Synthetic Records ---"
    let hd = pkg::make_display_info("HDMI-1", 0, 0, 1920, 1080, 100, 96, 60000, 32, 1, 0, "sRGB")
    let retina = pkg::make_display_info("Built-in", 1920, 0, 3456, 2234, 200, 254, 120000, 32, 0, 0, "Display P3")
    let side = pkg::make_display_info("Side", -1080, 0, 1080, 1920, 100, 96, 60000, 32, 0, 90, "")
    say "HD:     " + pkg::format_display(hd)
    say "Retina: " + pkg::format_display(retina)
    say "Side:   " + pkg::format_display(side)
    say "HD summary:     " + hd.summary()
    say "Retina HiDPI:   " + str(retina.is_hidpi())
    say "Side portrait:  " + str(side.is_portrait())
    say "HD effective:   " + str(pkg::effective(hd)[0]) + "x" + str(pkg::effective(hd)[1])
    say "Retina effect.: " + str(pkg::effective(retina)[0]) + "x" + str(pkg::effective(retina)[1])
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. Formatters & metrics
    # ───────────────────────────────────────────────────────────
    say "--- 4. Formatters & Metrics ---"
    say "Scale 100: " + pkg::format_scale(100)
    say "Scale 150: " + pkg::format_scale(150)
    say "Scale 200: " + pkg::format_scale(200)
    say "DPI 96:    " + pkg::format_dpi(96)
    say "60Hz:      " + pkg::format_refresh(60000)
    say "144Hz:     " + pkg::format_refresh(144000)
    let trio = [hd, retina, side]
    say "Max Hz:    " + str(pkg::max_hz(trio))
    say "Max DPI:   " + str(pkg::max_display_dpi(trio))
    say "HiDPI:     " + str(len(pkg::hidpi_only(trio)))
    say ""

    # ───────────────────────────────────────────────────────────
    # 5. Feature-gated extras
    # ───────────────────────────────────────────────────────────
    say "--- 5. Extras (feature-gated) ---"
    @cfg(feature = "extras")
    say "Scaling: " + pkg::scaling_report()
    @cfg(feature = "extras")
    say "Layout:  " + pkg::layout_report()
    @cfg(not(feature = "extras"))
    say "Extras: (disabled — rebuild with --features extras)"
    say ""

    say "Done!"
end

main()
