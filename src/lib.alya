## display Library Facade
##
## Cross-platform display enumeration for Alya: monitor count, resolution,
## position, DPI, scale/zoom, refresh rate, color depth, orientation, and
## color profile. Headless-safe: 0 / [] / null when no display server is
## reachable (CI, Docker, SSH). Part of the Alya Language package ecosystem
## (https://github.com/alya-lang).

import "./types.alya"
import "./ffi.alya"
import "./display.alya"
import "./metrics.alya"
import "./core/formatter.alya"
@cfg(feature = "extras")
import "./core/extras.alya"

# ───────────────────────────────────────────────────────────────
# Enumeration Facade
# ───────────────────────────────────────────────────────────────

## Returns the number of enumerated displays (0 when headless/unknown).
##
## ### Returns
## Display count (>= 0, never negative).
##
## ### Examples
## ```alya
## let n = display_count()
## ```
pub function display_count() -> int
    return display_count_native()
end

## Returns display records for every enumerated monitor (possibly empty headless).
##
## Canonical enumeration lives in `src/display.alya` and is re-exported here;
## call `displays()` directly (no facade wrapper, to avoid symbol duplication).
##
## ### Examples
## ```alya
## let list = displays()
## ```

## Returns the display at enumeration index i, or null when missing.
pub function display_at(i: int)
    return display_at_index(i)
end

## Returns 1 when at least one display is reachable, 0 otherwise.
pub function has_display() -> bool
    return has_displays()
end

## Returns 1 when no display server is reachable, 0 otherwise.
pub function headless() -> bool
    return is_headless()
end

## Returns the enumeration index of the primary display (-1 when none).
##
## Canonical query lives in `src/display.alya` (`primary_index()`); re-exported here.

## Returns the primary display record, or null when none is reachable.
pub function primary()
    return primary_display()
end

## Returns the primary display, or the first one as fallback (null when none).
##
## Canonical query lives in `src/display.alya` (`primary_or_first()`); re-exported here.

## Returns all display names in enumeration order.
pub function names() -> array
    return display_names()
end

## Returns the display with the given OS name, or null when absent.
pub function find(name: string)
    return find_display(name)
end

## Returns the largest display by pixel area (null when none).
pub function largest()
    return largest_display()
end

## Returns the sum of all display pixel areas (0 when headless).
pub function total_px() -> int
    return total_pixels()
end

## Returns the virtual-desktop bounding box over all displays.
pub function layout() -> DisplayLayout
    return virtual_desktop()
end

## Returns the raw native mode count for enumeration index i (0 when unknown).
pub function mode_count(i: int) -> int
    return mode_count_at(i)
end

## Returns video modes for enumeration index i, deduped (native order).
pub function modes(i: int) -> array
    return display_modes_at(i)
end

## Returns video modes for enumeration index i, deduped and sorted.
pub function sorted_modes(i: int) -> array
    return sorted_modes_at(i)
end

## Returns a topology signature string for change polling ("" when headless).
pub function signature() -> string
    return topology_signature()
end

## Returns 1 when the topology differs from a previous signature, 0 otherwise.
pub function changed_since(since: string) -> bool
    return topology_changed(since)
end

# ───────────────────────────────────────────────────────────────
# Metrics Facade (pure, headless-safe)
# ───────────────────────────────────────────────────────────────

## Returns the effective (logical) size `[w, h]` after scale division.
pub function effective(d: DisplayInfo) -> array
    return effective_size(d)
end

## Returns the highest refresh rate in Hz (-1.0 when none known).
pub function max_hz(list: array) -> float
    return max_refresh_hz(list)
end

## Returns the highest DPI in the list (-1 when none known).
pub function max_display_dpi(list: array) -> int
    return max_dpi(list)
end

# ───────────────────────────────────────────────────────────────
# Snapshot Facade
# ───────────────────────────────────────────────────────────────

## Returns a one-line human-readable display snapshot.
##
## Headless-safe: `"Displays: none (headless)"` when nothing is reachable.
##
## ### Returns
## Formatted snapshot string (count + first display).
pub function summary() -> string
    return format_snapshot(displays())
end

## Returns a detailed multi-line display report.
##
## ### Returns
## One line per display plus a layout line.
pub function details() -> string
    return format_report(displays(), virtual_desktop())
end

# ───────────────────────────────────────────────────────────────
# Native C FFI helper (bundled engine smoke test)
# ───────────────────────────────────────────────────────────────

## Native C FFI helper function
pub function c_add(a: int = 0, b: int = 0) -> int
    return alya_display_add(a, b)
end

# ───────────────────────────────────────────────────────────────
# Feature-Gated API Fallback Stubs
# ───────────────────────────────────────────────────────────────

# Slim-view stubs keep the public API surface stable when the `extras`
# feature is disabled, so callers get a clear descriptive error instead of
# an undefined reference (params unused by design).
# alya-lint: disable unused-param
## Fallback stub for `hidpi_displays` when the `extras` feature is disabled.
@cfg(not(feature = "extras"))
pub function hidpi_displays() -> array
    throw "extras feature is disabled (rebuild with default features or --features extras)"
end

