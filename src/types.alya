## display Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Platform-neutral models for display enumeration: monitor geometry, DPI,
## scale factor, refresh rate, color depth, orientation, and color profile.
## Nothing here touches the OS, so it is fully headless-testable.

# ───────────────────────────────────────────────────────────────
# Structural Interfaces (Duck Typing)
# ───────────────────────────────────────────────────────────────

## Public interface for objects capable of producing a formatted string summary.
##
## Any struct implementing a `summary(self) -> string` method implicitly
## satisfies this interface via Alya's structural duck-typing runtime.
pub interface Summarizable
    function summary(self) -> string
end

## Public interface for objects that provide detailed status descriptions and validation.
##
## Structs implementing `describe(self) -> string` and `is_valid(self) -> int`
## satisfy this contract without explicit inheritance declarations.
pub interface Describable
    function describe(self) -> string
    function is_valid(self) -> int
end

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Physical rotation of a display panel in degrees.
##
## Wire values are always one of 0/90/180/270 (see `DisplayInfo.orientation`).
pub enum DisplayOrientation
    Landscape = 0,
    Portrait = 90,
    Inverted = 180,
    Flipped = 270
end

## Scale-factor buckets for quick HiDPI classification.
##
## Thresholds are advisory: 100% is baseline, 125%+ is scaled, 150%+ is HiDPI.
pub enum DisplayScale
    Native = 100,
    Scaled = 125,
    HiDpi = 150,
    Retina = 200
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## Single display record (unknown numerics are -1, unknown text is "").
##
## ### Fields
## - `name`: OS device label (`"\\\\.\\DISPLAY1"`, `"Display 1"`, `"HDMI-1"`).
## - `x`: Left edge in virtual-desktop pixels (may be negative).
## - `y`: Top edge in virtual-desktop pixels (may be negative).
## - `w`: Width in device pixels (> 0 when known).
## - `h`: Height in device pixels (> 0 when known).
## - `scale_x100`: Scale percent (100 = 1.00x, 200 = 2.00x Retina, -1 unknown).
## - `dpi`: Dots per inch (-1 when unknown, e.g. projectors/VMs).
## - `refresh_milliHz`: Refresh in milli-Hz (60000 = 60Hz, -1 unknown).
## - `bpp`: Bits per pixel (32/24/16/8, -1 unknown).
## - `primary`: 1 for the primary display, 0 otherwise.
## - `orientation`: Panel rotation (0/90/180/270).
## - `color`: OS color profile label (`"sRGB"`, `"Display P3"`, "" unknown).
## - `work_x`, `work_y`: Usable-area origin in virtual-desktop pixels.
## - `work_w`, `work_h`: Usable-area size (taskbar/dock excluded, `<= 0` unknown).
## - `connector`: Physical connector (`"internal"`, `"hdmi"`, `"dp"`, `"edp"`, `"dvi"`, `"vga"`, "" unknown).
## - `gpu`: Adapter/driver label (`"NVIDIA GeForce RTX 4070"`, `"amdgpu"`, "" unknown).
## - `label`: Friendly monitor name (`"DELL U2720Q"`, "" unknown).
## - `edid_make`: EDID manufacturer trigraph (`"SAM"`, "" unknown).
## - `edid_model`: EDID monitor name (`"U2720Q"`, "" unknown).
## - `edid_serial`: EDID serial text/number ("" unknown).
## - `wide_gamut`: 1 wide-gamut (P3), 0 standard sRGB, -1 unknown.
## - `hdr`: 1 HDR active/capable, 0 SDR-only, -1 unknown.
pub struct DisplayInfo
    name: string,
    x: int,
    y: int,
    w: int,
    h: int,
    scale_x100: int,
    dpi: int,
    refresh_milliHz: int,
    bpp: int,
    primary: int,
    orientation: int,
    color: string,
    work_x: int,
    work_y: int,
    work_w: int,
    work_h: int,
    connector: string,
    gpu: string,
    label: string,
    edid_make: string,
    edid_model: string,
    edid_serial: string,
    wide_gamut: int,
    hdr: int
end

## Virtual-desktop bounding box over all displays.
##
## ### Fields
## - `x`: Left edge of the union rect.
## - `y`: Top edge of the union rect.
## - `w`: Union width (0 when there are no displays).
## - `h`: Union height (0 when there are no displays).
## - `count`: Number of displays covered.
## - `primary_name`: Name of the primary display ("" when none).
pub struct DisplayLayout
    x: int,
    y: int,
    w: int,
    h: int,
    count: int,
    primary_name: string
end

## Single video mode (resolution + refresh triplet).
##
## Returned by `display_modes_at()` after dedupe/sort; the current mode is
## not flagged (compare against the owning `DisplayInfo.refresh_milliHz`).
##
## ### Fields
## - `w`: Width in device pixels (> 0).
## - `h`: Height in device pixels (> 0).
## - `refresh_milliHz`: Refresh in milli-Hz (60000 = 60Hz, -1 unknown).
pub struct DisplayMode
    w: int,
    h: int,
    refresh_milliHz: int
end

# ───────────────────────────────────────────────────────────────
# Private Helper Functions
# ───────────────────────────────────────────────────────────────

# Internal sanitizer ensuring a non-empty, non-null string fallback.
function sanitize_text_internal(text, fallback: string) -> string
    return when
        text is null => fallback
        text == ""   => fallback
        else         => text
    end
end

# ───────────────────────────────────────────────────────────────
# Public Factory Constructors
# ───────────────────────────────────────────────────────────────

## Builds a `DisplayInfo` record from explicit values (testing/snapshots).
##
## ### Parameters
## - `name`: OS device label.
## - `x`: Left edge in virtual-desktop pixels. Defaults to `0`.
## - `y`: Top edge in virtual-desktop pixels. Defaults to `0`.
## - `w`: Width in device pixels.
## - `h`: Height in device pixels.
## - `scale_x100`: Scale percent (100 = 1.00x). Defaults to `100`.
## - `dpi`: Dots per inch (-1 unknown). Defaults to `-1`.
## - `refresh_milliHz`: Refresh in milli-Hz (-1 unknown). Defaults to `-1`.
## - `bpp`: Bits per pixel (-1 unknown). Defaults to `-1`.
## - `primary`: 1 for primary, 0 otherwise. Defaults to `0`.
## - `orientation`: Panel rotation. Defaults to `0`.
## - `color`: Color profile label. Defaults to `""`.
## - `work_x`, `work_y`: Usable-area origin. Defaults to `0`.
## - `work_w`, `work_h`: Usable-area size (`<= 0` unknown). Defaults to `-1`.
## - `connector`: Physical connector. Defaults to `""`.
## - `gpu`: Adapter/driver label. Defaults to `""`.
## - `label`: Friendly monitor name. Defaults to `""`.
## - `edid_make`, `edid_model`, `edid_serial`: EDID identity. Defaults to `""`.
## - `wide_gamut`: 1 wide-gamut, 0 sRGB, -1 unknown. Defaults to `-1`.
## - `hdr`: 1 HDR, 0 SDR-only, -1 unknown. Defaults to `-1`.
##
## ### Returns
## A fully initialized `DisplayInfo` instance.
##
## ### Examples
## ```alya
## let d = make_display_info("HDMI-1", 0, 0, 1920, 1080, 100, 96, 60000, 32, 1, 0, "sRGB")
## ```
pub function make_display_info(name: string, x: int = 0, y: int = 0, w: int = 0, h: int = 0, scale_x100: int = 100, dpi: int = -1, refresh_milliHz: int = -1, bpp: int = -1, primary: int = 0, orientation: int = 0, color: string = "", work_x: int = 0, work_y: int = 0, work_w: int = -1, work_h: int = -1, connector: string = "", gpu: string = "", label: string = "", edid_make: string = "", edid_model: string = "", edid_serial: string = "", wide_gamut: int = -1, hdr: int = -1) -> DisplayInfo
    return DisplayInfo {
        name: sanitize_text_internal(name, "Display"),
        x: x,
        y: y,
        w: w,
        h: h,
        scale_x100: scale_x100,
        dpi: dpi,
        refresh_milliHz: refresh_milliHz,
        bpp: bpp,
        primary: primary,
        orientation: orientation,
        color: color,
        work_x: work_x,
        work_y: work_y,
        work_w: work_w,
        work_h: work_h,
        connector: connector,
        gpu: gpu,
        label: label,
        edid_make: edid_make,
        edid_model: edid_model,
        edid_serial: edid_serial,
        wide_gamut: wide_gamut,
        hdr: hdr
    }
end

## Builds an empty (unknown) `DisplayInfo` record.
##
## Useful as a null-object fallback when no display is reachable.
pub function empty_display() -> DisplayInfo
    return DisplayInfo {
        name: "",
        x: 0,
        y: 0,
        w: -1,
        h: -1,
        scale_x100: -1,
        dpi: -1,
        refresh_milliHz: -1,
        bpp: -1,
        primary: 0,
        orientation: 0,
        color: "",
        work_x: 0,
        work_y: 0,
        work_w: -1,
        work_h: -1,
        connector: "",
        gpu: "",
        label: "",
        edid_make: "",
        edid_model: "",
        edid_serial: "",
        wide_gamut: -1,
        hdr: -1
    }
end

## Builds a `DisplayLayout` record from explicit values.
pub function make_display_layout(x: int = 0, y: int = 0, w: int = 0, h: int = 0, count: int = 0, primary_name: string = "") -> DisplayLayout
    return DisplayLayout {
        x: x,
        y: y,
        w: w,
        h: h,
        count: count,
        primary_name: primary_name
    }
end

## Builds a `DisplayMode` record from explicit values (testing/snapshots).
##
## ### Parameters
## - `w`: Width in device pixels.
## - `h`: Height in device pixels.
## - `refresh_milliHz`: Refresh in milli-Hz (-1 unknown). Defaults to `-1`.
##
## ### Returns
## A fully initialized `DisplayMode` instance.
##
## ### Examples
## ```alya
## let m = make_display_mode(1920, 1080, 60000)
## ```
pub function make_display_mode(w: int = 0, h: int = 0, refresh_milliHz: int = -1) -> DisplayMode
    return DisplayMode {
        w: w,
        h: h,
        refresh_milliHz: refresh_milliHz
    }
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: DisplayInfo
# ───────────────────────────────────────────────────────────────

## Returns 1 when this record holds a known mode (`w > 0` and `h > 0`).
pub function DisplayInfo.is_known(self: DisplayInfo) -> bool
    if self.w > 0 and self.h > 0
        return true
    end
    return false
end

## Returns 1 when this is the primary display, 0 otherwise.
pub function DisplayInfo.is_primary(self: DisplayInfo) -> bool
    if self.primary == true
        return true
    end
    return false
end

## Returns the pixel area (`w * h`), or 0 for unknown modes.
pub function DisplayInfo.area(self: DisplayInfo) -> int
    if self.w <= 0 or self.h <= 0
        return 0
    end
    return self.w * self.h
end

## Returns the scale factor (1.0 = 100%, 2.0 = Retina, -1.0 unknown).
pub function DisplayInfo.scale(self: DisplayInfo) -> float
    if self.scale_x100 <= 0
        return -1.0
    end
    return self.scale_x100 / 100.0
end

## Returns the refresh rate in Hz (60.0, 144.0, -1.0 unknown).
pub function DisplayInfo.refresh_hz(self: DisplayInfo) -> float
    if self.refresh_milliHz <= 0
        return -1.0
    end
    return self.refresh_milliHz / 1000.0
end

## Returns 1 when the panel reports HiDPI scale (>= 150%), 0 otherwise.
pub function DisplayInfo.is_hidpi(self: DisplayInfo) -> bool
    if self.scale_x100 >= 150
        return true
    end
    return false
end

## Returns 1 when the panel is portrait (90/270 degrees), 0 otherwise.
pub function DisplayInfo.is_portrait(self: DisplayInfo) -> bool
    if self.orientation == 90 or self.orientation == 270
        return true
    end
    return false
end

## Returns the mode string (`"1920x1080"`, `"unknown"` when not known).
pub function DisplayInfo.resolution(self: DisplayInfo) -> string
    if self.is_known() == false
        return "unknown"
    end
    return f"{self.w}x{self.h}"
end

## Returns a one-line summary (`"HDMI-1 1920x1080 @60Hz x1.00 [primary]"`).
##
## Implicitly satisfies the `Summarizable` interface.
pub function DisplayInfo.summary(self: DisplayInfo) -> string
    if self.is_known() == false
        return f"{self.name} unknown"
    end
    let tag = ""
    if self.is_primary() == true
        tag = " [primary]"
    end
    return f"{self.name} {self.resolution()}{tag}"
end

## Returns a detailed multi-field description of this display.
##
## Implicitly satisfies the `Describable` interface.
pub function DisplayInfo.describe(self: DisplayInfo) -> string
    return f"[Display] name={self.name}, origin=({self.x},{self.y}), mode={self.resolution()}, scale={self.scale_x100}, dpi={self.dpi}, refresh={self.refresh_milliHz}, bpp={self.bpp}, primary={self.primary}, orient={self.orientation}, color={self.color}"
end

## Returns 1 when this record is usable (known mode, sane scale/orientation).
##
## Implicitly satisfies the `Describable` interface.
pub function DisplayInfo.is_valid(self: DisplayInfo) -> bool
    if self.is_known() == false
        return false
    end
    if self.scale_x100 != -1 and self.scale_x100 <= 0
        return false
    end
    if self.orientation != 0 and self.orientation != 90 and self.orientation != 180 and self.orientation != 270
        return false
    end
    return true
end

## Returns 1 when a usable area is known (`work_w > 0` and `work_h > 0`).
pub function DisplayInfo.has_work_area(self: DisplayInfo) -> bool
    if self.work_w > 0 and self.work_h > 0
        return true
    end
    return false
end

## Returns the usable-area string (`"1840x1010 @0,40"`, `"unknown"` when none).
pub function DisplayInfo.work_summary(self: DisplayInfo) -> string
    if self.has_work_area() == false
        return "unknown"
    end
    return f"{self.work_w}x{self.work_h} @{self.work_x},{self.work_y}"
end

## Returns 1 when HDR is active/capable, 0 otherwise (unknown counts as 0).
pub function DisplayInfo.is_hdr(self: DisplayInfo) -> bool
    if self.hdr == true
        return true
    end
    return false
end

## Returns 1 when the panel reports wide-gamut, 0 otherwise (unknown is 0).
pub function DisplayInfo.is_wide_gamut(self: DisplayInfo) -> bool
    if self.wide_gamut == true
        return true
    end
    return false
end

## Returns 1 when any EDID identity datum is present, 0 otherwise.
pub function DisplayInfo.has_edid(self: DisplayInfo) -> bool
    if len(self.edid_make) > 0 or len(self.edid_model) > 0 or len(self.edid_serial) > 0
        return true
    end
    return false
end

## Returns the EDID identity label (`"SAM U2720Q #1234"`, `""` when none).
pub function DisplayInfo.edid_label(self: DisplayInfo) -> string
    if self.has_edid() == false
        return ""
    end
    let s = self.edid_make
    if len(self.edid_model) > 0
        if len(s) > 0
            s += " "
        end
        s += self.edid_model
    end
    if len(self.edid_serial) > 0
        if len(s) > 0
            s += " #"
        end
        s += self.edid_serial
    end
    return s
end

## Returns 1 when a friendly monitor name is known, 0 otherwise.
pub function DisplayInfo.has_label(self: DisplayInfo) -> bool
    if self.label is null or len(self.label) == 0
        return false
    end
    return true
end

## Returns 1 when adapter/driver info is known, 0 otherwise.
pub function DisplayInfo.has_gpu(self: DisplayInfo) -> bool
    if self.gpu is null or len(self.gpu) == 0
        return false
    end
    return true
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: DisplayLayout
# ───────────────────────────────────────────────────────────────

## Returns 1 when the layout covers at least one display.
pub function DisplayLayout.is_known(self: DisplayLayout) -> bool
    if self.count > 0 and self.w > 0 and self.h > 0
        return true
    end
    return false
end

## Returns the virtual-desktop area (`w * h`), or 0 when unknown.
pub function DisplayLayout.area(self: DisplayLayout) -> int
    if self.w <= 0 or self.h <= 0
        return 0
    end
    return self.w * self.h
end

## Returns a one-line summary (`"2 displays 3840x1080 @0,0"`).
##
## Implicitly satisfies the `Summarizable` interface.
pub function DisplayLayout.summary(self: DisplayLayout) -> string
    if self.is_known() == false
        return "no displays"
    end
    let plural = "s"
    if self.count == 1
        plural = ""
    end
    return f"{self.count} display{plural} {self.w}x{self.h} @{self.x},{self.y}"
end

## Returns a detailed description of this layout.
##
## Implicitly satisfies the `Describable` interface.
pub function DisplayLayout.describe(self: DisplayLayout) -> string
    return f"[Layout] origin=({self.x},{self.y}), size={self.w}x{self.h}, count={self.count}, primary={self.primary_name}"
end

## Returns 1 when this layout is usable (count matches positive size).
##
## Implicitly satisfies the `Describable` interface.
pub function DisplayLayout.is_valid(self: DisplayLayout) -> bool
    if self.count < 0
        return false
    end
    if self.count == 0
        return true
    end
    return self.is_known()
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: DisplayMode
# ───────────────────────────────────────────────────────────────

## Returns 1 when this mode has a known resolution (`w > 0` and `h > 0`).
pub function DisplayMode.is_known(self: DisplayMode) -> bool
    if self.w > 0 and self.h > 0
        return true
    end
    return false
end

## Returns the pixel area (`w * h`), or 0 for unknown modes.
pub function DisplayMode.area(self: DisplayMode) -> int
    if self.w <= 0 or self.h <= 0
        return 0
    end
    return self.w * self.h
end

## Returns the refresh rate in Hz (60.0, 144.0, -1.0 unknown).
pub function DisplayMode.refresh_hz(self: DisplayMode) -> float
    if self.refresh_milliHz <= 0
        return -1.0
    end
    return self.refresh_milliHz / 1000.0
end

## Returns the mode string (`"1920x1080"`, `"unknown"` when not known).
pub function DisplayMode.resolution(self: DisplayMode) -> string
    if self.is_known() == false
        return "unknown"
    end
    return f"{self.w}x{self.h}"
end

## Returns a one-line summary (`"1920x1080 @60Hz"`, `"1920x1080"` when Hz unknown).
##
## Implicitly satisfies the `Summarizable` interface.
pub function DisplayMode.summary(self: DisplayMode) -> string
    if self.is_known() == false
        return "unknown"
    end
    if self.refresh_milliHz > 0
        let whole = self.refresh_milliHz / 1000
        let rest = self.refresh_milliHz - whole * 1000
        if rest == 0
            return f"{self.resolution()} @{whole}Hz"
        end
        return f"{self.resolution()} @{self.refresh_hz()}Hz"
    end
    return self.resolution()
end

## Returns a detailed description of this mode.
##
## Implicitly satisfies the `Describable` interface.
pub function DisplayMode.describe(self: DisplayMode) -> string
    return f"[Mode] {self.resolution()} refresh={self.refresh_milliHz}"
end

## Returns 1 when this mode is usable (known resolution, sane refresh).
##
## Implicitly satisfies the `Describable` interface.
pub function DisplayMode.is_valid(self: DisplayMode) -> bool
    if self.is_known() == false
        return false
    end
    if self.refresh_milliHz != -1 and self.refresh_milliHz <= 0
        return false
    end
    return true
end
