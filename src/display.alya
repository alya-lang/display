## display/display — enumeration & parsing
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Index-based native enumeration with a pipe-separated wire format, following
## the proven `sysinfo` mounts/net pattern: entries that fail to parse are
## skipped, so output length may be < display_count() under hotplug races.
## Headless-safe: 0 / [] / null when no display server is reachable.

import "std/str"
import "./types.alya"
import "./ffi.alya"
import "./core/strutil.alya"

## Returns the number of enumerated displays (0 when headless/unknown).
pub function display_count_native() -> int
    let n = display_native_count()
    if n < 0
        return 0
    end
    return n
end

## Parses one native wire entry into a DisplayInfo record, or null when malformed.
##
## Wire: "name|x|y|w|h|scale_x100|dpi|refresh_milliHz|bpp|primary|orientation|color"
function parse_display_entry(entry: string)
    let parts = split(entry, "|")
    if len(parts) != 12
        return null
    end
    let w = to_int(parts[3])
    let h = to_int(parts[4])
    if w <= 0 or h <= 0
        return null
    end
    if len(parts[0]) == 0
        return null
    end
    let orient = to_int(parts[10])
    if orient != 0 and orient != 90 and orient != 180 and orient != 270
        orient = 0
    end
    let prim = 0
    if parts[9] == "1"
        prim = 1
    end
    return DisplayInfo {
        name: parts[0],
        x: to_int(parts[1]),
        y: to_int(parts[2]),
        w: w,
        h: h,
        scale_x100: to_int(parts[5]),
        dpi: to_int(parts[6]),
        refresh_milliHz: to_int(parts[7]),
        bpp: to_int(parts[8]),
        primary: prim,
        orientation: orient,
        color: parts[11],
        work_x: 0,
        work_y: 0,
        work_w: -1,
        work_h: -1,
        connector: "",
        gpu: "",
        label: "",
        edid_make: "",
        edid_model: "",
        edid_serial: "",
        wide_gamut: -1,
        hdr: -1
    }
end

## Parses one native extra wire entry, or null when malformed.
##
## Wire: "work_x|work_y|work_w|work_h|connector|gpu|label|edid_make|edid_model|edid_serial|wide|hdr"
function parse_extra_entry(entry: string)
    let parts = split(entry, "|")
    if len(parts) != 12
        return null
    end
    let wide = to_int(parts[10])
    if wide != 1 and wide != 0
        wide = -1
    end
    let hdr = to_int(parts[11])
    if hdr != 1 and hdr != 0
        hdr = -1
    end
    return {
        "work_x": to_int(parts[0]),
        "work_y": to_int(parts[1]),
        "work_w": to_int(parts[2]),
        "work_h": to_int(parts[3]),
        "connector": parts[4],
        "gpu": parts[5],
        "label": parts[6],
        "edid_make": parts[7],
        "edid_model": parts[8],
        "edid_serial": parts[9],
        "wide": wide,
        "hdr": hdr
    }
end

## Applies a parsed extra map onto a DisplayInfo record (returns the update).
function apply_extra(d: DisplayInfo, extra) -> DisplayInfo
    return DisplayInfo {
        name: d.name,
        x: d.x,
        y: d.y,
        w: d.w,
        h: d.h,
        scale_x100: d.scale_x100,
        dpi: d.dpi,
        refresh_milliHz: d.refresh_milliHz,
        bpp: d.bpp,
        primary: d.primary,
        orientation: d.orientation,
        color: d.color,
        work_x: extra["work_x"],
        work_y: extra["work_y"],
        work_w: extra["work_w"],
        work_h: extra["work_h"],
        connector: extra["connector"],
        gpu: extra["gpu"],
        label: extra["label"],
        edid_make: extra["edid_make"],
        edid_model: extra["edid_model"],
        edid_serial: extra["edid_serial"],
        wide_gamut: extra["wide"],
        hdr: extra["hdr"]
    }
end

## Returns display records for every enumerated monitor (possibly empty headless).
##
## Tolerates native index skew like mounts(): empty or malformed entries
## (holes from concurrent hotplug) are skipped. Extended data (work area,
## connector, GPU, EDID, HDR) merges per index when available and stays at
## unknown sentinels otherwise.
pub function displays() -> array
    let out = []
    let n = display_count_native()
    let i = 0
    while i < n
        let entry = str_owned(display_native_at(i))
        if len(entry) > 0
            let d = parse_display_entry(entry)
            if d is not null
                let exraw = str_owned(display_native_extra(i))
                if len(exraw) > 0
                    let ex = parse_extra_entry(exraw)
                    if ex is not null
                        d = apply_extra(d, ex)
                    end
                end
                out.push(d)
            end
        end
        i += 1
    end
    return out
end

## Returns the display at enumeration index i, or null when missing.
pub function display_at_index(i: int)
    if i < 0
        return null
    end
    let entry = str_owned(display_native_at(i))
    if len(entry) == 0
        return null
    end
    let d = parse_display_entry(entry)
    if d is null
        return null
    end
    let exraw = str_owned(display_native_extra(i))
    if len(exraw) > 0
        let ex = parse_extra_entry(exraw)
        if ex is not null
            d = apply_extra(d, ex)
        end
    end
    return d
end

## Returns 1 when at least one display is reachable, 0 otherwise (headless).
pub function has_displays() -> bool
    return len(displays()) > 0
end

## Returns 1 when no display server is reachable (CI/Docker/SSH), 0 otherwise.
pub function is_headless() -> bool
    if has_displays() == true
        return false
    end
    return true
end

## Returns the enumeration index of the primary display (-1 when none).
pub function primary_index() -> int
    let list = displays()
    let i = 0
    while i < len(list)
        let d: DisplayInfo = list[i]
        if d.is_primary() == true
            return i
        end
        i += 1
    end
    return -1
end

## Returns the primary display record, or null when none is reachable.
pub function primary_display()
    let list = displays()
    let i = 0
    while i < len(list)
        let d: DisplayInfo = list[i]
        if d.is_primary() == true
            return d
        end
        i += 1
    end
    return null
end

## Returns the primary display, or the first one as fallback (null when none).
pub function primary_or_first()
    let p = primary_display()
    if p is not null
        return p
    end
    let list = displays()
    if len(list) > 0
        return list[0]
    end
    return null
end

## Returns all display names in enumeration order.
pub function display_names() -> array
    let out = []
    let list = displays()
    for d in list
        let info: DisplayInfo = d
        out.push(info.name)
    end
    return out
end

## Returns the display with the given OS name, or null when absent.
pub function find_display(name: string)
    if name is null or len(name) == 0
        return null
    end
    let list = displays()
    for d in list
        let info: DisplayInfo = d
        if info.name == name
            return info
        end
    end
    return null
end

## Returns the largest display by pixel area (null when none).
pub function largest_display()
    let list = displays()
    let best_idx = -1
    let best_area = 0
    let i = 0
    while i < len(list)
        let info: DisplayInfo = list[i]
        let a = info.area()
        if a > best_area
            best_area = a
            best_idx = i
        end
        i += 1
    end
    if best_idx < 0
        return null
    end
    # Typed local on purpose: returning list[best_idx] directly reads back
    # as null on some targets (observed on Xvfb); the annotation pins the
    # struct type across the return boundary.
    let best: DisplayInfo = list[best_idx]
    return best
end

## Returns the sum of all display pixel areas (0 when headless).
pub function total_pixels() -> int
    let total = 0
    let list = displays()
    for d in list
        let info: DisplayInfo = d
        total += info.area()
    end
    return total
end

## Returns the virtual-desktop bounding box over all displays.
##
## The union covers negative origins (left/above-primary monitors); the
## result is `make_display_layout(0, 0, 0, 0, 0, "")` when headless.
pub function virtual_desktop() -> DisplayLayout
    let list = displays()
    if len(list) == 0
        return make_display_layout(0, 0, 0, 0, 0, "")
    end
    let first: DisplayInfo = list[0]
    let min_x = first.x
    let min_y = first.y
    let max_x = first.x + first.w
    let max_y = first.y + first.h
    let pname = ""
    if first.is_primary() == true
        pname = first.name
    end
    let i = 1
    while i < len(list)
        let d: DisplayInfo = list[i]
        if d.x < min_x
            min_x = d.x
        end
        if d.y < min_y
            min_y = d.y
        end
        let ex = d.x + d.w
        let ey = d.y + d.h
        if ex > max_x
            max_x = ex
        end
        if ey > max_y
            max_y = ey
        end
        if d.is_primary() == true
            pname = d.name
        end
        i += 1
    end
    return make_display_layout(min_x, min_y, max_x - min_x, max_y - min_y, len(list), pname)
end

# ───────────────────────────────────────────────────────────────
# Video Modes
# ───────────────────────────────────────────────────────────────

## Parses one native mode wire entry ("w|h|refresh_milliHz"), or null when malformed.
function parse_mode_entry(entry: string)
    let parts = split(entry, "|")
    if len(parts) != 3
        return null
    end
    let w = to_int(parts[0])
    let h = to_int(parts[1])
    if w <= 0 or h <= 0
        return null
    end
    let r = to_int(parts[2])
    if r != -1 and r <= 0
        r = -1
    end
    return make_display_mode(w, h, r)
end

## Returns the raw native mode count for enumeration index i (0 when unknown).
pub function mode_count_at(i: int) -> int
    return len(display_modes_at(i))
end

## Returns the video modes for enumeration index i, deduped and sorted.
##
## Sort order is largest area first, then highest refresh. Pixel-format and
## orientation duplicates from the native list collapse into one entry.
## Backends that cannot enumerate report the current mode as one entry.
## One native enumeration per call by design.
pub function display_modes_at(i: int) -> array
    let raw = []
    if i < 0
        return raw
    end
    let blob = str_owned(display_native_modes_all(i))
    if len(blob) == 0
        return raw
    end
    let lines = split(blob, "\n")
    let k = 0
    while k < len(lines)
        let line = trim(lines[k])
        if len(line) > 0
            let m = parse_mode_entry(line)
            if m is not null
                raw.push(m)
            end
        end
        k += 1
    end
    return dedupe_modes(raw)
end

## Dedupes exact (w,h,refresh) triplets, keeping first-seen order.
function dedupe_modes(list: array) -> array
    let out = []
    if list is null
        return out
    end
    for m in list
        let cand: DisplayMode = m
        let dup = false
        for e in out
            let have: DisplayMode = e
            if have.w == cand.w and have.h == cand.h and have.refresh_milliHz == cand.refresh_milliHz
                dup = true
            end
        end
        if dup == false
            out.push(cand)
        end
    end
    return out
end

## Sorts modes largest-area first (ties: highest refresh first).
##
## Selection sort is plenty: native lists stay in the low hundreds.
pub function sort_modes(list: array) -> array
    let work = []
    if list is null
        return work
    end
    for m in list
        work.push(m)
    end
    let i = 0
    while i < len(work)
        let best = i
        let j = i + 1
        while j < len(work)
            let a: DisplayMode = work[j]
            let b: DisplayMode = work[best]
            let swap = false
            if a.area() > b.area()
                swap = true
            elif a.area() == b.area() and a.refresh_milliHz > b.refresh_milliHz
                swap = true
            end
            if swap == true
                best = j
            end
            j += 1
        end
        if best != i
            let tmp = work[i]
            work[i] = work[best]
            work[best] = tmp
        end
        i += 1
    end
    return work
end

## Returns the video modes for enumeration index i, deduped and sorted.
pub function sorted_modes_at(i: int) -> array
    return sort_modes(display_modes_at(i))
end

## Returns the best mode of a list (largest area, tie: highest refresh).
##
## Returns null for empty lists.
pub function best_mode(modes: array)
    if modes is null or len(modes) == 0
        return null
    end
    let ordered = sort_modes(modes)
    return ordered[0]
end

# ───────────────────────────────────────────────────────────────
# Topology Signatures (hotplug/change polling)
# ───────────────────────────────────────────────────────────────

## Returns a topology signature string for the current enumeration.
##
## The signature joins per-display `name|x|y|w|h|scale|refresh` cells with
## `;` (empty string when headless). Poll it on an interval and compare with
## `topology_changed()` to detect hotplug, mode, scale, or refresh changes
## without keeping native handles open.
pub function topology_signature() -> string
    let cells = []
    let list = displays()
    for d in list
        let info: DisplayInfo = d
        cells.push("{info.name}|{info.x}|{info.y}|{info.w}|{info.h}|{info.scale_x100}|{info.refresh_milliHz}")
    end
    if len(cells) == 0
        return ""
    end
    let s = cells[0]
    let i = 1
    while i < len(cells)
        s += ";" + cells[i]
        i += 1
    end
    return s
end

## Returns 1 when the topology differs from a previous signature, 0 otherwise.
##
## Headless-to-headless (both "") reports 0 (no change).
pub function topology_changed(since: string) -> bool
    let now = topology_signature()
    if now == since
        return false
    end
    return true
end
