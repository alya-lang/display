## display Core Formatting Engine
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Human-readable formatters for scale, DPI, refresh rate, and display snapshots.

import "../types.alya"

## Formats a scale percent as `"1.50x"`, `"1x"` when exact, `"unknown"` for -1.
##
## Integer tenths arithmetic keeps output identical on every platform.
pub function format_scale(scale_x100: int) -> string
    if scale_x100 <= 0
        return "unknown"
    end
    let tenths = (scale_x100 + 5) / 10
    let whole = tenths / 10
    let frac = tenths - whole * 10
    if frac == 0
        return "{whole}x"
    end
    return "{whole}.{frac}x"
end

## Formats a DPI value as `"96 dpi"` (`"unknown dpi"` for -1).
pub function format_dpi(dpi: int) -> string
    if dpi <= 0
        return "unknown dpi"
    end
    return "{dpi} dpi"
end

## Formats a milli-Hz refresh as `"60Hz"`, `"59.94Hz"`, `"unknown"` for -1.
pub function format_refresh(refresh_milliHz: int) -> string
    if refresh_milliHz <= 0
        return "unknown"
    end
    let whole = refresh_milliHz / 1000
    let rest = refresh_milliHz - whole * 1000
    if rest == 0
        return "{whole}Hz"
    end
    let frac = (rest + 5) / 10
    if frac >= 100
        whole += 1
        frac -= 100
    end
    if frac == 0
        return "{whole}Hz"
    end
    let tens = frac / 10
    let ones = frac - tens * 10
    if ones == 0
        return "{whole}.{tens}Hz"
    end
    return "{whole}.{tens}{ones}Hz"
end

## Formats a resolution as `"1920x1080"` (`"unknown"` when not known).
pub function format_resolution(d: DisplayInfo) -> string
    return d.resolution()
end

## Formats one display (`"HDMI-1 1920x1080 @60Hz x1 (96 dpi) [primary]"`).
pub function format_display(d: DisplayInfo) -> string
    if d.is_known() == false
        return "{d.name} unknown"
    end
    let s = "{d.name} {d.resolution()}"
    let hz = format_refresh(d.refresh_milliHz)
    if hz != "unknown"
        s += " @" + hz
    end
    let sc = format_scale(d.scale_x100)
    if sc != "unknown"
        s += " " + sc
    end
    if d.dpi > 0
        s += " ({d.dpi} dpi)"
    end
    if d.bpp > 0
        s += " {d.bpp}bpp"
    end
    if len(d.color) > 0
        s += " [{d.color}]"
    end
    if d.is_primary() == true
        s += " [primary]"
    end
    if d.is_portrait() == true
        s += " [portrait {d.orientation}deg]"
    end
    return s
end

## Formats a display list, one entry per line (`"(no displays)"` when empty).
pub function format_display_list(list: array) -> string
    if list is null or len(list) == 0
        return "(no displays)"
    end
    let s = ""
    let i = 0
    while i < len(list)
        if i > 0
            s += "\n"
        end
        s += format_display(list[i])
        i += 1
    end
    return s
end

## Formats a virtual-desktop layout (`"2 displays 3840x1080 @0,0"`).
pub function format_layout(layout: DisplayLayout) -> string
    return layout.summary()
end

## Formats a full one-line snapshot over a display list.
pub function format_snapshot(list: array) -> string
    if list is null or len(list) == 0
        return "Displays: none (headless)"
    end
    let n = len(list)
    let word = "display"
    if n != 1
        word = "displays"
    end
    let first = format_display(list[0])
    if n == 1
        return "Displays: 1 {word} | {first}"
    end
    return "Displays: {n} {word} | {first} (+{n - 1} more)"
end

## Formats a detailed multi-line report (one section per display + layout line).
pub function format_report(list: array, layout: DisplayLayout) -> string
    let s = "Displays: {len(list)}"
    let i = 0
    while i < len(list)
        s += "\n  [{i}] {format_display(list[i])}"
        i += 1
    end
    s += "\nLayout:   {layout.summary()}"
    return s
end
