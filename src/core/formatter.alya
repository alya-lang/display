## display Core Formatting Engine
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Human-readable formatters for scale, DPI, refresh rate, and display snapshots.

import "../types.alya"

## Formats a scale percent as `"1.50x"`, `"1x"` when exact, `"unknown"` for -1.
##
## Integer tenths arithmetic keeps output identical on every platform.
pub function format_scale(scale_x100: int) -> string
    if scale_x100 <= 0
        return "unknown"
    end
    let tenths = (scale_x100 + 5) / 10
    let whole = tenths / 10
    let frac = tenths - whole * 10
    if frac == 0
        return f"{whole}x"
    end
    return f"{whole}.{frac}x"
end

## Formats a DPI value as `"96 dpi"` (`"unknown dpi"` for -1).
pub function format_dpi(dpi: int) -> string
    if dpi <= 0
        return "unknown dpi"
    end
    return f"{dpi} dpi"
end

## Formats a milli-Hz refresh as `"60Hz"`, `"59.94Hz"`, `"unknown"` for -1.
pub function format_refresh(refresh_milliHz: int) -> string
    if refresh_milliHz <= 0
        return "unknown"
    end
    let whole = refresh_milliHz / 1000
    let rest = refresh_milliHz - whole * 1000
    if rest == 0
        return f"{whole}Hz"
    end
    let frac = (rest + 5) / 10
    if frac >= 100
        whole += 1
        frac -= 100
    end
    if frac == 0
        return f"{whole}Hz"
    end
    let tens = frac / 10
    let ones = frac - tens * 10
    if ones == 0
        return f"{whole}.{tens}Hz"
    end
    return f"{whole}.{tens}{ones}Hz"
end

## Formats a resolution as `"1920x1080"` (`"unknown"` when not known).
pub function format_resolution(d: DisplayInfo) -> string
    return d.resolution()
end

## Formats one display (`"HDMI-1 1920x1080 @60Hz x1 (96 dpi) [primary]"`).
pub function format_display(d: DisplayInfo) -> string
    if d.is_known() == false
        return f"{d.name} unknown"
    end
    let s = f"{d.name} {d.resolution()}"
    let hz = format_refresh(d.refresh_milliHz)
    if hz != "unknown"
        s += " @" + hz
    end
    let sc = format_scale(d.scale_x100)
    if sc != "unknown"
        s += " " + sc
    end
    if d.dpi > 0
        s += f" ({d.dpi} dpi)"
    end
    if d.bpp > 0
        s += f" {d.bpp}bpp"
    end
    if len(d.color) > 0
        s += f" [{d.color}]"
    end
    if len(d.connector) > 0
        s += f" <{d.connector}>"
    end
    if d.is_hdr() == true
        s += " [HDR]"
    elif d.is_wide_gamut() == true
        s += " [wide-gamut]"
    end
    if d.has_label() == true
        s += f" \"{d.label}\""
    end
    if d.is_primary() == true
        s += " [primary]"
    end
    if d.is_portrait() == true
        s += f" [portrait {d.orientation}deg]"
    end
    return s
end

## Formats a display list, one entry per line (`"(no displays)"` when empty).
pub function format_display_list(list: array) -> string
    if list is null or len(list) == 0
        return "(no displays)"
    end
    let s = ""
    let i = 0
    while i < len(list)
        if i > 0
            s += "\n"
        end
        s += format_display(list[i])
        i += 1
    end
    return s
end

## Formats a virtual-desktop layout (`"2 displays 3840x1080 @0,0"`).
pub function format_layout(layout: DisplayLayout) -> string
    return layout.summary()
end

## Formats a full one-line snapshot over a display list.
pub function format_snapshot(list: array) -> string
    if list is null or len(list) == 0
        return "Displays: none (headless)"
    end
    let n = len(list)
    let word = "display"
    if n != 1
        word = "displays"
    end
    let first = format_display(list[0])
    if n == 1
        return f"Displays: 1 {word} | {first}"
    end
    return f"Displays: {n} {word} | {first} (+{n - 1} more)"
end

## Formats a detailed multi-line report (one section per display + layout line).
pub function format_report(list: array, layout: DisplayLayout) -> string
    let s = f"Displays: {len(list)}"
    let i = 0
    while i < len(list)
        s += f"\n  [{i}] {format_display(list[i])}"
        i += 1
    end
    s += f"\nLayout:   {layout.summary()}"
    return s
end

## Formats one video mode (`"1920x1080 @60Hz"`, `"1920x1080"` when Hz unknown).
pub function format_mode(m: DisplayMode) -> string
    return m.summary()
end

## Formats a mode list, one per line, capped at max_n entries (`"(no modes)"` when empty).
##
## Beyond the cap the tail collapses into a `"+N more"` line so huge EDID
## mode tables stay readable.
pub function format_mode_list(modes: array, max_n: int = 8) -> string
    if modes is null or len(modes) == 0
        return "(no modes)"
    end
    let cap = max_n
    if cap <= 0
        cap = 8
    end
    let s = ""
    let i = 0
    while i < len(modes) and i < cap
        if i > 0
            s += "\n"
        end
        let m: DisplayMode = modes[i]
        s += format_mode(m)
        i += 1
    end
    if len(modes) > cap
        s += f"\n+{len(modes) - cap} more"
    end
    return s
end

## Formats EDID identity (`"SAM U2720Q #1234"`, `"no EDID"` when absent).
pub function format_edid(d: DisplayInfo) -> string
    let lbl = d.edid_label()
    if len(lbl) == 0
        return "no EDID"
    end
    return lbl
end

## Formats the usable area (`"1840x1010 @0,40"`, `"full bounds"` when unknown).
pub function format_work_area(d: DisplayInfo) -> string
    if d.has_work_area() == false
        return "full bounds"
    end
    return d.work_summary()
end
