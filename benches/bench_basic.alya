## Benchmark suite for display
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("display Micro-Benchmarks")

    # Bench 1: native enumeration (headless-safe, small N: opens/closes display)
    bench_start(runner, 200)
    let i = 0
    while i < 200
        pkg::display_count()
        i += 1
    end
    bench_stop(runner, "display_count() 200 calls")

    # Bench 2: full enumeration + parse
    bench_start(runner, 200)
    let j = 0
    while j < 200
        pkg::displays()
        j += 1
    end
    bench_stop(runner, "displays() 200 calls")

    # Bench 3: synthetic record + format_display — 50k iterations
    let d = pkg::make_display_info("HDMI-1", 0, 0, 1920, 1080, 100, 96, 60000, 32, 1, 0, "sRGB")
    bench_start(runner, 50000)
    let k = 0
    while k < 50000
        pkg::format_display(d)
        k += 1
    end
    bench_stop(runner, "format_display() 50k calls")

    # Bench 4: struct methods (area + scale + refresh) — 200k iterations
    bench_start(runner, 200000)
    let s = 0
    while s < 200000
        d.area()
        d.scale()
        d.refresh_hz()
        s += 1
    end
    bench_stop(runner, "area/scale/refresh 200k calls")

    # Bench 5: formatters (scale + dpi + refresh) — 100k iterations
    bench_start(runner, 100000)
    let c = 0
    while c < 100000
        pkg::format_scale(150)
        pkg::format_dpi(96)
        pkg::format_refresh(60000)
        c += 1
    end
    bench_stop(runner, "format helpers 100k calls")

    # Bench 6: metrics (effective + filters over 3-item list) — 20k iterations
    let trio = [d, pkg::make_display_info("4K", 1920, 0, 3840, 2160, 200, 163, 144000, 32, 0, 0, ""), pkg::make_display_info("Side", 0, 0, 1080, 1920, 100, 96, 60000, 32, 0, 90, "")]
    bench_start(runner, 20000)
    let m = 0
    while m < 20000
        pkg::effective_size(d)
        pkg::hidpi_only(trio)
        pkg::max_refresh_hz(trio)
        m += 1
    end
    bench_stop(runner, "metrics over trio 20k calls")

    # Bench 7: virtual desktop + snapshot — 5k iterations
    bench_start(runner, 5000)
    let v = 0
    while v < 5000
        pkg::format_snapshot(trio)
        pkg::make_display_layout(0, 0, 3840, 2160, 2, "HDMI-1")
        v += 1
    end
    bench_stop(runner, "snapshot/layout 5k calls")

    # Bench 8: mode sort + format over 12-item list — 10k iterations
    let modelist = [pkg::make_display_mode(1920, 1080, 60000), pkg::make_display_mode(2560, 1440, 144000), pkg::make_display_mode(3840, 2160, 60000), pkg::make_display_mode(1280, 720, 60000), pkg::make_display_mode(1920, 1080, 144000), pkg::make_display_mode(3840, 2160, 120000), pkg::make_display_mode(1600, 900, 60000), pkg::make_display_mode(2560, 1440, 60000), pkg::make_display_mode(1920, 1200, 60000), pkg::make_display_mode(3440, 1440, 100000), pkg::make_display_mode(1920, 1080, 240000), pkg::make_display_mode(7680, 4320, 60000)]
    bench_start(runner, 10000)
    let b = 0
    while b < 10000
        pkg::sort_modes(modelist)
        b += 1
    end
    bench_stop(runner, "sort_modes 12-item 10k calls")

    # Bench 9: native mode enumeration + topology signature — 20 iterations
    bench_start(runner, 20)
    let g = 0
    while g < 20
        pkg::modes(0)
        pkg::signature()
        g += 1
    end
    bench_stop(runner, "modes(0)+signature 20 calls")

    bench_summary(runner)
end

main()
