## Test suite for display
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("display Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Enumerations
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::DisplayOrientation.Landscape, 0, "DisplayOrientation.Landscape == 0")
    runner_assert_eq(r, pkg::DisplayOrientation.Portrait, 90, "DisplayOrientation.Portrait == 90")
    runner_assert_eq(r, pkg::DisplayOrientation.Inverted, 180, "DisplayOrientation.Inverted == 180")
    runner_assert_eq(r, pkg::DisplayOrientation.Flipped, 270, "DisplayOrientation.Flipped == 270")

    runner_assert_eq(r, pkg::DisplayScale.Native, 100, "DisplayScale.Native == 100")
    runner_assert_eq(r, pkg::DisplayScale.Scaled, 125, "DisplayScale.Scaled == 125")
    runner_assert_eq(r, pkg::DisplayScale.HiDpi, 150, "DisplayScale.HiDpi == 150")
    runner_assert_eq(r, pkg::DisplayScale.Retina, 200, "DisplayScale.Retina == 200")

    # ═══════════════════════════════════════════════════════════
    # 2. Struct models & factory constructors (deterministic)
    # ═══════════════════════════════════════════════════════════
    let d = pkg::make_display_info("HDMI-1", 0, 0, 1920, 1080, 100, 96, 60000, 32, 1, 0, "sRGB")
    runner_assert_str_eq(r, d.name, "HDMI-1", "d.name is initialized correctly")
    runner_assert_eq(r, d.x, 0, "d.x is 0")
    runner_assert_eq(r, d.y, 0, "d.y is 0")
    runner_assert_eq(r, d.w, 1920, "d.w is 1920")
    runner_assert_eq(r, d.h, 1080, "d.h is 1080")
    runner_assert_eq(r, d.scale_x100, 100, "d.scale_x100 is 100")
    runner_assert_eq(r, d.dpi, 96, "d.dpi is 96")
    runner_assert_eq(r, d.refresh_milliHz, 60000, "d.refresh is 60000")
    runner_assert_eq(r, d.bpp, 32, "d.bpp is 32")
    runner_assert_eq(r, d.primary, 1, "d.primary is 1")
    runner_assert_eq(r, d.orientation, 0, "d.orientation is 0")
    runner_assert_str_eq(r, d.color, "sRGB", "d.color is sRGB")

    let retina = pkg::make_display_info("Built-in", 0, 0, 3456, 2234, 200, 254, 120000, 32, 1, 0, "Display P3")
    runner_assert_eq(r, retina.is_hidpi(), true, "retina.is_hidpi() == 1")
    runner_assert_eq(r, d.is_hidpi(), false, "1080p@100% is not HiDPI")

    let portrait = pkg::make_display_info("Side", 1920, 0, 1080, 1920, 100, 96, 60000, 32, 0, 90, "")
    runner_assert_eq(r, portrait.is_portrait(), true, "90deg is portrait")
    runner_assert_eq(r, d.is_portrait(), false, "0deg is not portrait")

    runner_assert_eq(r, d.is_primary(), true, "d.is_primary() == 1")
    runner_assert_eq(r, portrait.is_primary(), false, "portrait.is_primary() == 0")
    runner_assert_eq(r, d.is_known(), true, "d.is_known() == 1")
    runner_assert_eq(r, d.area(), 2073600, "1920x1080 area is 2073600")
    runner_assert_str_eq(r, d.resolution(), "1920x1080", "d.resolution() == 1920x1080")
    runner_assert_eq(r, d.is_valid(), true, "d.is_valid() == 1")

    let empty = pkg::empty_display()
    runner_assert_eq(r, empty.is_known(), false, "empty_display is not known")
    runner_assert_eq(r, empty.area(), 0, "empty area is 0")
    runner_assert_str_eq(r, empty.resolution(), "unknown", "empty resolution is unknown")
    runner_assert_eq(r, empty.scale(), -1.0, "empty scale is -1.0")
    runner_assert_eq(r, empty.refresh_hz(), -1.0, "empty refresh is -1.0")

    runner_assert_eq(r, d.scale(), 1.0, "100% scale is 1.0")
    runner_assert_eq(r, retina.scale(), 2.0, "200% scale is 2.0")
    runner_assert_eq(r, d.refresh_hz(), 60.0, "60000mHz is 60Hz")
    runner_assert_eq(r, retina.refresh_hz(), 120.0, "120000mHz is 120Hz")

    # ═══════════════════════════════════════════════════════════
    # 3. Duck typing (interfaces)
    # ═══════════════════════════════════════════════════════════
    let is_summ = d is pkg::Summarizable
    runner_assert_true(r, is_summ, "DisplayInfo satisfies Summarizable implicitly")
    runner_assert_true(r, len(d.summary()) > 0, "d.summary() returns non-empty string")

    let is_desc = d is pkg::Describable
    runner_assert_true(r, is_desc, "DisplayInfo satisfies Describable implicitly")
    runner_assert_true(r, len(d.describe()) > 0, "d.describe() returns non-empty description")

    let layout = pkg::make_display_layout(0, 0, 3840, 1080, 2, "HDMI-1")
    runner_assert_eq(r, layout.is_known(), true, "layout.is_known() == 1")
    runner_assert_eq(r, layout.area(), 4147200, "layout area is 4147200")
    runner_assert_true(r, layout is pkg::Summarizable, "DisplayLayout satisfies Summarizable")
    runner_assert_true(r, layout is pkg::Describable, "DisplayLayout satisfies Describable")
    runner_assert_str_eq(r, layout.summary(), "2 displays 3840x1080 @0,0", "layout.summary() vector")

    let nolayout = pkg::make_display_layout(0, 0, 0, 0, 0, "")
    runner_assert_eq(r, nolayout.is_known(), false, "empty layout is not known")
    runner_assert_str_eq(r, nolayout.summary(), "no displays", "empty layout summary")

    # ═══════════════════════════════════════════════════════════
    # 4. Formatter vectors (deterministic)
    # ═══════════════════════════════════════════════════════════
    runner_assert_str_eq(r, pkg::format_scale(100), "1x", "format_scale 100 == 1x")
    runner_assert_str_eq(r, pkg::format_scale(150), "1.5x", "format_scale 150 == 1.5x")
    runner_assert_str_eq(r, pkg::format_scale(200), "2x", "format_scale 200 == 2x")
    runner_assert_str_eq(r, pkg::format_scale(125), "1.3x", "format_scale 125 rounds to 1.3x")
    runner_assert_str_eq(r, pkg::format_scale(-1), "unknown", "format_scale -1 == unknown")

    runner_assert_str_eq(r, pkg::format_dpi(96), "96 dpi", "format_dpi 96")
    runner_assert_str_eq(r, pkg::format_dpi(-1), "unknown dpi", "format_dpi unknown")

    runner_assert_str_eq(r, pkg::format_refresh(60000), "60Hz", "format_refresh 60Hz")
    runner_assert_str_eq(r, pkg::format_refresh(144000), "144Hz", "format_refresh 144Hz")
    runner_assert_str_eq(r, pkg::format_refresh(59940), "59.94Hz", "format_refresh 59.94Hz")
    runner_assert_str_eq(r, pkg::format_refresh(-1), "unknown", "format_refresh unknown")

    runner_assert_str_eq(r, pkg::format_resolution(d), "1920x1080", "format_resolution vector")
    runner_assert_true(r, len(pkg::format_display(d)) > 0, "format_display returns non-empty string")
    runner_assert_str_eq(r, pkg::format_display(empty), " unknown", "format_display empty vector")
    runner_assert_str_eq(r, pkg::format_display_list([]), "(no displays)", "format_display_list empty")
    runner_assert_true(r, len(pkg::format_display_list([d, portrait])) > 0, "format_display_list two entries")
    runner_assert_str_eq(r, pkg::format_layout(nolayout), "no displays", "format_layout empty")
    runner_assert_str_eq(r, pkg::format_snapshot([]), "Displays: none (headless)", "format_snapshot headless")
    runner_assert_true(r, len(pkg::format_snapshot([d])) > 0, "format_snapshot single non-empty")

    # ═══════════════════════════════════════════════════════════
    # 5. Metrics vectors (deterministic, no hardware)
    # ═══════════════════════════════════════════════════════════
    let eff = pkg::effective(retina)
    runner_assert_eq(r, eff[0], 1728, "retina effective width is 1728")
    runner_assert_eq(r, eff[1], 1117, "retina effective height is 1117")
    runner_assert_eq(r, pkg::effective(d)[0], 1920, "100% effective width unchanged")
    runner_assert_eq(r, pkg::has_dpi(d), true, "d has DPI")
    runner_assert_eq(r, pkg::has_dpi(empty), false, "empty has no DPI")
    runner_assert_eq(r, pkg::has_refresh(d), true, "d has refresh")
    runner_assert_eq(r, pkg::has_refresh(empty), false, "empty has no refresh")
    runner_assert_eq(r, pkg::has_color_profile(d), true, "d has color profile")
    runner_assert_eq(r, pkg::has_color_profile(portrait), false, "portrait has no color profile")

    let pair = [d, retina]
    runner_assert_eq(r, len(pkg::hidpi_only(pair)), 1, "hidpi_only filters to retina")
    runner_assert_eq(r, len(pkg::portrait_only(pair)), 0, "portrait_only empty for landscapes")
    runner_assert_eq(r, len(pkg::portrait_only([portrait])), 1, "portrait_only finds portrait")
    runner_assert_eq(r, len(pkg::refresh_at_least(pair, 120.0)), 1, "refresh_at_least finds 120Hz")
    runner_assert_eq(r, pkg::max_refresh_hz(pair), 120.0, "max refresh is 120Hz")
    runner_assert_eq(r, pkg::max_refresh_hz([]), -1.0, "max refresh empty is -1.0")
    runner_assert_eq(r, pkg::max_dpi(pair), 254, "max DPI is 254")
    runner_assert_eq(r, pkg::max_dpi([]), -1, "max DPI empty is -1")

    # ═══════════════════════════════════════════════════════════
    # 6. Live enumeration (headless-tolerant: 0 valid on CI/Docker/SSH)
    # ═══════════════════════════════════════════════════════════
    let n = pkg::display_count()
    runner_assert_true(r, n >= 0, "display_count is non-negative")
    let list = pkg::displays()
    runner_assert_true(r, len(list) <= n, "displays length does not exceed count (hotplug skew)")
    runner_assert_true(r, len(list) >= 0, "displays length is non-negative")

    let i = 0
    while i < len(list)
        let info: DisplayInfo = list[i]
        runner_assert_true(r, info.is_known(), "live display is known")
        runner_assert_true(r, info.is_valid(), "live display is valid")
        runner_assert_true(r, len(info.name) > 0, "live display has a name")
        runner_assert_true(r, info.w > 0, "live display width positive")
        runner_assert_true(r, info.h > 0, "live display height positive")
        runner_assert_true(r, info.scale_x100 == -1 or info.scale_x100 > 0, "live scale sane")
        runner_assert_true(r, info.dpi == -1 or info.dpi > 0, "live DPI sane")
        runner_assert_true(r, len(pkg::format_display(info)) > 0, "live format_display non-empty")
        i += 1
    end

    let pi = pkg::primary_index()
    runner_assert_true(r, pi >= -1, "primary_index is -1 or non-negative")
    runner_assert_true(r, pi < len(list), "primary_index within bounds")
    if len(list) == 0
        runner_assert_eq(r, pi, -1, "headless primary_index is -1")
        runner_assert_eq(r, pkg::primary_display() is null, true, "headless primary is null")
        runner_assert_eq(r, pkg::primary_or_first() is null, true, "headless primary_or_first is null")
        runner_assert_eq(r, pkg::largest_display() is null, true, "headless largest is null")
        runner_assert_eq(r, pkg::total_pixels(), 0, "headless total pixels is 0")
        runner_assert_eq(r, pkg::has_displays(), false, "headless has_displays is 0")
        runner_assert_eq(r, pkg::is_headless(), true, "headless is_headless is 1")
        runner_assert_eq(r, pkg::has_display(), false, "headless has_display is 0")
        runner_assert_eq(r, pkg::headless(), true, "headless headless() is 1")
    else
        runner_assert_eq(r, pkg::has_displays(), true, "attached has_displays is 1")
        runner_assert_eq(r, pkg::is_headless(), false, "attached is_headless is 0")
        let prim = pkg::primary_or_first()
        runner_assert_eq(r, prim is null, false, "attached primary_or_first non-null")
        let big = pkg::largest_display()
        runner_assert_eq(r, big is null, false, "attached largest non-null")
        runner_assert_true(r, pkg::total_pixels() > 0, "attached total pixels positive")
        runner_assert_eq(r, len(pkg::display_names()), len(list), "names length matches")
        let first: DisplayInfo = list[0]
        let found = pkg::find_display(first.name)
        runner_assert_eq(r, found is null, false, "find_display locates first display")
        let at0 = pkg::display_at_index(0)
        runner_assert_eq(r, at0 is null, false, "display_at_index(0) non-null when attached")
        runner_assert_eq(r, pkg::display_at_index(-1) is null, true, "negative index is null")
        runner_assert_eq(r, pkg::display_at_index(9999) is null, true, "huge index is null")
    end
    runner_assert_eq(r, pkg::find_display("display-missing-xyz") is null, true, "missing name is null")
    runner_assert_eq(r, pkg::find_display("") is null, true, "empty name is null")

    let vd = pkg::virtual_desktop()
    runner_assert_eq(r, vd.count, len(list), "virtual_desktop count matches")
    runner_assert_eq(r, pkg::layout().count, len(list), "layout() count matches")
    if len(list) > 0
        runner_assert_eq(r, vd.is_known(), true, "attached layout is known")
        runner_assert_true(r, len(pkg::details()) > 0, "details() non-empty when attached")
    else
        runner_assert_eq(r, vd.is_known(), false, "headless layout unknown")
    end
    runner_assert_true(r, len(pkg::summary()) > 0, "summary() always non-empty")
    runner_assert_true(r, len(pkg::details()) > 0, "details() always non-empty")

    # ═══════════════════════════════════════════════════════════
    # 7. Feature-gated extras (default-on)
    # ═══════════════════════════════════════════════════════════
    @cfg(feature = "extras")
    runner_assert_eq(r, len(pkg::hidpi_displays()) <= len(pkg::displays()), true, "hidpi subset")
    @cfg(feature = "extras")
    runner_assert_eq(r, len(pkg::portrait_displays()) <= len(pkg::displays()), true, "portrait subset")
    @cfg(feature = "extras")
    runner_assert_true(r, len(pkg::scaling_report()) > 0, "scaling_report non-empty")
    @cfg(feature = "extras")
    runner_assert_true(r, len(pkg::layout_report()) > 0, "layout_report non-empty")
    @cfg(feature = "extras")
    runner_assert_eq(r, len(pkg::high_refresh_displays(120.0)) <= len(pkg::displays()), true, "high-refresh subset")
    @cfg(feature = "extras")
    runner_assert_eq(r, len(pkg::hdr_displays()) <= len(pkg::displays()), true, "hdr subset")
    @cfg(feature = "extras")
    runner_assert_eq(r, len(pkg::wide_gamut_displays()) <= len(pkg::displays()), true, "wide-gamut subset")
    @cfg(feature = "extras")
    runner_assert_true(r, len(pkg::mode_report()) > 0, "mode_report non-empty")

    # ═══════════════════════════════════════════════════════════
    # 8. DisplayMode models, sorting & video modes
    # ═══════════════════════════════════════════════════════════
    let m60 = pkg::make_display_mode(1920, 1080, 60000)
    let m144 = pkg::make_display_mode(1920, 1080, 144000)
    let m4k = pkg::make_display_mode(3840, 2160, 60000)
    runner_assert_eq(r, m60.w, 1920, "mode w is 1920")
    runner_assert_eq(r, m60.refresh_milliHz, 60000, "mode refresh is 60000")
    runner_assert_eq(r, m60.is_known(), true, "mode is known")
    runner_assert_eq(r, m60.area(), 2073600, "mode area is 2073600")
    runner_assert_eq(r, m60.refresh_hz(), 60.0, "mode 60Hz")
    runner_assert_eq(r, m144.refresh_hz(), 144.0, "mode 144Hz")
    runner_assert_str_eq(r, m60.resolution(), "1920x1080", "mode resolution")
    runner_assert_str_eq(r, m60.summary(), "1920x1080 @60Hz", "mode summary")
    runner_assert_str_eq(r, pkg::make_display_mode(1920, 1080, -1).summary(), "1920x1080", "mode summary unknown Hz")
    runner_assert_str_eq(r, pkg::empty_display().work_summary(), "unknown", "empty work summary")
    runner_assert_eq(r, m60.is_valid(), true, "mode is valid")
    runner_assert_true(r, m60 is pkg::Summarizable, "DisplayMode satisfies Summarizable")
    runner_assert_true(r, m60 is pkg::Describable, "DisplayMode satisfies Describable")
    runner_assert_true(r, len(m60.describe()) > 0, "mode describe non-empty")

    let dup_modes = [m60, m144, m60, m4k, m144]
    let sorted = pkg::sort_modes(dup_modes)
    runner_assert_eq(r, len(sorted), 5, "sort keeps all entries")
    let first_sorted: DisplayMode = sorted[0]
    runner_assert_eq(r, first_sorted.w, 3840, "sort puts 4K first")
    let second_sorted: DisplayMode = sorted[1]
    runner_assert_eq(r, second_sorted.refresh_milliHz, 144000, "sort prefers 144Hz on tie")
    let best = pkg::best_mode(dup_modes)
    runner_assert_eq(r, best is null, false, "best_mode non-null")
    let best_mode: DisplayMode = best
    runner_assert_eq(r, best_mode.w, 3840, "best_mode is 4K")
    runner_assert_eq(r, pkg::best_mode([]) is null, true, "best_mode empty is null")
    runner_assert_eq(r, pkg::sort_modes([]) is null, false, "sort empty non-null")
    runner_assert_eq(r, len(pkg::sort_modes([])), 0, "sort empty is empty")

    runner_assert_str_eq(r, pkg::format_mode(m60), "1920x1080 @60Hz", "format_mode vector")
    runner_assert_str_eq(r, pkg::format_mode_list([]), "(no modes)", "format_mode_list empty")
    runner_assert_str_eq(r, pkg::format_mode_list([m60, m144]), "1920x1080 @60Hz\n1920x1080 @144Hz", "format_mode_list two")
    runner_assert_str_eq(r, pkg::format_mode_list([m60, m144, m4k], 2), "1920x1080 @60Hz\n1920x1080 @144Hz\n+1 more", "format_mode_list cap collapse")
    runner_assert_str_eq(r, pkg::format_edid(d), "no EDID", "format_edid empty")
    let edid_d = pkg::make_display_info("DP-1", 0, 0, 2560, 1440, 100, 109, 144000, 32, 1, 0, "", 0, 0, 2560, 1400, "dp", "NVIDIA GeForce RTX 4070", "DELL U2720Q", "DEL", "U2720Q", "1234", -1, 0)
    runner_assert_str_eq(r, pkg::format_edid(edid_d), "DEL U2720Q #1234", "format_edid vector")
    runner_assert_eq(r, edid_d.has_edid(), true, "edid present")
    runner_assert_eq(r, d.has_edid(), false, "plain d has no edid")
    runner_assert_eq(r, edid_d.has_label(), true, "edid_d has label")
    runner_assert_eq(r, edid_d.has_gpu(), true, "edid_d has gpu")
    runner_assert_eq(r, edid_d.has_work_area(), true, "edid_d has work area")
    runner_assert_str_eq(r, edid_d.work_summary(), "2560x1400 @0,0", "work summary vector")
    runner_assert_str_eq(r, pkg::format_work_area(edid_d), "2560x1400 @0,0", "format_work_area vector")
    runner_assert_str_eq(r, pkg::format_work_area(d), "full bounds", "format_work_area unknown")
    runner_assert_eq(r, pkg::has_work_area(edid_d), true, "has_work_area true")
    runner_assert_eq(r, pkg::has_edid_info(edid_d), true, "has_edid_info true")
    let hdr_d = pkg::make_display_info("HDMI-2", 0, 0, 3840, 2160, 200, 163, 120000, 30, 0, 0, "Display P3", 0, 0, -1, -1, "hdmi", "", "", "", "", "", 1, 1)
    runner_assert_eq(r, hdr_d.is_hdr(), true, "hdr flag set")
    runner_assert_eq(r, hdr_d.is_wide_gamut(), true, "wide flag set")
    runner_assert_eq(r, d.is_hdr(), false, "plain d not hdr")
    runner_assert_true(r, len(pkg::format_display(hdr_d)) > 0, "hdr format non-empty")
    runner_assert_eq(r, len(pkg::hdr_only([d, hdr_d])), 1, "hdr_only filters")
    runner_assert_eq(r, len(pkg::wide_gamut_only([d, hdr_d])), 1, "wide filter")

    # Native mode enumeration (headless-safe: 0/empty when unreachable)
    runner_assert_eq(r, pkg::mode_count(-1), 0, "mode_count negative is 0")
    runner_assert_eq(r, len(pkg::modes(-1)), 0, "modes negative empty")
    runner_assert_eq(r, len(pkg::modes(9999)), 0, "modes OOB empty")
    runner_assert_eq(r, len(pkg::sorted_modes(9999)), 0, "sorted OOB empty")
    if len(list) > 0
        runner_assert_true(r, pkg::mode_count(0) >= 1, "attached display has modes")
        let livemodes = pkg::sorted_modes(0)
        runner_assert_true(r, len(livemodes) >= 1, "attached sorted modes non-empty")
        let lm0: DisplayMode = livemodes[0]
        runner_assert_eq(r, lm0.is_valid(), true, "live mode valid")
        runner_assert_true(r, len(pkg::format_mode(lm0)) > 0, "live format_mode non-empty")
        let li = 1
        while li < len(livemodes)
            let prev: DisplayMode = livemodes[li - 1]
            let cur: DisplayMode = livemodes[li]
            runner_assert_true(r, prev.area() >= cur.area(), "sorted areas non-increasing")
            li += 1
        end
        let live0: DisplayInfo = list[0]
        runner_assert_true(r, len(live0.work_summary()) > 0, "work summary non-empty")
        runner_assert_true(r, len(pkg::format_work_area(live0)) > 0, "work format non-empty")
        runner_assert_true(r, len(pkg::format_edid(live0)) > 0, "edid format non-empty")
    end

    # ═══════════════════════════════════════════════════════════
    # 9. Topology signatures (hotplug polling)
    # ═══════════════════════════════════════════════════════════
    let sig = pkg::signature()
    runner_assert_eq(r, pkg::changed_since(sig), false, "fresh signature unchanged")
    runner_assert_eq(r, pkg::changed_since(sig + "x"), true, "mutated signature changed")
    if len(list) == 0
        runner_assert_str_eq(r, sig, "", "headless signature empty")
    else
        runner_assert_true(r, len(sig) > 0, "attached signature non-empty")
    end

    # 10. Native C FFI verification
    let c_sum = pkg::c_add(10, 32)
    runner_assert_eq(r, c_sum, 42, "pkg::c_add executes bundled C code")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
